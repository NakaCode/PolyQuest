# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── PyInstaller (artefatos de build, ~280MB) ────────────
build/
dist/
*.manifest
# NB: PolyQuest.spec é fonte (config do build) e fica versionado.
# Instalador vai para o GitHub Releases (não mais versionado no repo)
PolyQuest_Setup.exe
# Backup antigo do site (removido do versionamento)
index_v1_backup.html

# ── Claude Code (pode conter comandos com tokens locais) ─
.claude/settings.local.json

# ── Segredos / variáveis de ambiente ────────────────────
.env
.env.*
*.secret

# ── Supabase CLI (scratch local) ────────────────────────
supabase/.temp/

# ── Licença local / específica da máquina ───────────────
.polyquest_license
translation_cache.db
crash.log
# config.json é local (prefs do usuário e, com o Modo IA, API key!)
# O instalador usa config.default.json como modelo.
config.json

# ── Sistema operacional ─────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
